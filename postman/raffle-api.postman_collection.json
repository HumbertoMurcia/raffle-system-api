  "item": [
    {
      "name": "0. Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Liveness probe. Run this first to confirm the server is up.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 200', () => pm.response.to.have.status(200));",
                  "pm.test('reports ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Log in as Alice",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Mock login: a known seeded email is enough. The token itself is real: HMAC-SHA256 signed with an expiry.\n\nStores the token in the `token` collection variable, which every authenticated request below uses.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{aliceEmail}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('returns a bearer token and the account', () => {",
                  "  pm.expect(body.token).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.user.email).to.eql(pm.collectionVariables.get('aliceEmail'));",
                  "  pm.expect(body.user.balance).to.be.a('number');",
                  "});",
                  "pm.collectionVariables.set('token', body.token);",
                  "pm.collectionVariables.set('userId', body.user.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Log in as Carol (zero balance)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Carol is seeded with a balance of 0, used by the insufficient-funds case.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{carolEmail}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Carol has nothing to spend', () => pm.expect(body.user.balance).to.eql(0));",
                  "pm.collectionVariables.set('carolToken', body.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Log in with an unknown email (401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Unknown accounts are refused without revealing whether they exist.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"nobody@example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 401', () => pm.response.to.have.status(401));",
                  "pm.test('uses the standard error envelope', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.error.code).to.eql('UNAUTHORIZED');",
                  "  pm.expect(body.error.message).to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Browse raffles",
      "item": [
        {
          "name": "List active raffles",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/raffles",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "raffles"
              ]
            },
            "description": "Public. Defaults to `active`; pass `?status=` for another slice, or `all`.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 200', () => pm.response.to.have.status(200));",
                  "const { data } = pm.response.json();",
                  "pm.test('only active raffles are listed', () => {",
                  "  pm.expect(data).to.be.an('array').that.is.not.empty;",
                  "  data.forEach(r => pm.expect(r.status).to.eql('active'));",
                  "});",
                  "pm.test('each raffle exposes its prize and remaining capacity', () => {",
                  "  data.forEach(r => {",
                  "    pm.expect(r.prize.name).to.be.a('string');",
                  "    pm.expect(r.ticketsRemaining).to.eql(r.maxTickets - r.ticketsSold);",
                  "  });",
                  "});"
                ]
              }
            }
          ]
        },
