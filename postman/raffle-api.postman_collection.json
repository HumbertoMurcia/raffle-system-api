    {
      "name": "3. Tickets (purchase + retry safety)",
      "description": "Run top to bottom: this folder demonstrates that a retried purchase is charged once.",
      "item": [
        {
          "name": "Get me (capture balance)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "me"
              ]
            },
            "description": "Records the starting balance so the purchase below can be checked exactly."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 200', () => pm.response.to.have.status(200));",
                  "const me = pm.response.json();",
                  "pm.collectionVariables.set('balanceBefore', me.balance);",
                  "pm.test('returns the authenticated account', () => {",
                  "  pm.expect(me.id).to.eql(pm.collectionVariables.get('userId'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Purchase 2 tickets",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/raffles/{{raffleId}}/tickets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "raffles",
                "{{raffleId}}",
                "tickets"
              ]
            },
            "description": "`Idempotency-Key` is required. The pre-request script generates a fresh GUID; the next request reuses it on purpose.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// A new key for a new purchase. The retry request below deliberately",
                  "// reuses whatever this leaves in the collection variable.",
                  "pm.collectionVariables.set('idempotencyKey', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('is a fresh charge, not a replay', () => {",
                  "  pm.expect(body.replayed).to.be.false;",
                  "  pm.expect(pm.response.headers.get('idempotent-replay')).to.eql('false');",
                  "});",
                  "pm.test('issues 2 tickets with unique, consecutive numbers', () => {",
                  "  const numbers = body.tickets.map(t => t.ticketNumber);",
                  "  pm.expect(numbers).to.have.lengthOf(2);",
                  "  pm.expect(new Set(numbers).size).to.eql(2);",
                  "  pm.expect(numbers[1]).to.eql(numbers[0] + 1);",
                  "});",
                  "pm.test('one purchase is one payment', () => {",
                  "  pm.expect(new Set(body.tickets.map(t => t.paymentId)).size).to.eql(1);",
                  "  body.tickets.forEach(t => pm.expect(t.status).to.eql('confirmed'));",
                  "});",
                  "pm.test('debits price x quantity', () => {",
                  "  const before = Number(pm.collectionVariables.get('balanceBefore'));",
                  "  pm.expect(body.remainingBalance).to.eql(before - body.totalCost);",
                  "});",
                  "pm.collectionVariables.set('totalCost', body.totalCost);",
                  "pm.collectionVariables.set('paymentId', body.paymentId);",
                  "pm.collectionVariables.set('purchasedNumbers', JSON.stringify(body.tickets.map(t => t.ticketNumber)));"
                ]
              }
            }
          ]
        },
        {
          "name": "Retry the same purchase, same key (replayed, not charged)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/raffles/{{raffleId}}/tickets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "raffles",
                "{{raffleId}}",
                "tickets"
              ]
            },
            "description": "Identical request, identical key: what a client does after a timeout. The original result is replayed; no slot is claimed and no money moves.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 201 with the original result', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('is flagged as a replay', () => {",
                  "  pm.expect(body.replayed).to.be.true;",
                  "  pm.expect(pm.response.headers.get('idempotent-replay')).to.eql('true');",
                  "});",
                  "pm.test('returns the original tickets and payment, not new ones', () => {",
                  "  pm.expect(body.paymentId).to.eql(pm.collectionVariables.get('paymentId'));",
                  "  pm.expect(body.tickets.map(t => t.ticketNumber))",
                  "    .to.eql(JSON.parse(pm.collectionVariables.get('purchasedNumbers')));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Reuse the key for a different quantity (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/raffles/{{raffleId}}/tickets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "raffles",
                "{{raffleId}}",
                "tickets"
              ]
            },
            "description": "Same key, different request. Silently replaying the wrong purchase would be worse than refusing.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 9\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 409', () => pm.response.to.have.status(409));",
                  "pm.test('uses the standard error envelope', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.error.code).to.eql('IDEMPOTENCY_KEY_REUSED');",
                  "  pm.expect(body.error.message).to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Purchase without an idempotency key (422)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/raffles/{{raffleId}}/tickets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "raffles",
                "{{raffleId}}",
                "tickets"
              ]
            },
            "description": "The key is required: a purchase moves money and must be retry-safe.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 422', () => pm.response.to.have.status(422));",
                  "pm.test('names the missing header', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.error.code).to.eql('VALIDATION_ERROR');",
                  "  pm.expect(body.error.details[0].path).to.eql('/idempotency-key');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Purchase an invalid quantity (422)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/raffles/{{raffleId}}/tickets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "raffles",
                "{{raffleId}}",
                "tickets"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// A new key for a new purchase. The retry request below deliberately",
                  "// reuses whatever this leaves in the collection variable.",
                  "pm.collectionVariables.set('idempotencyKey', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 422', () => pm.response.to.have.status(422));",
                  "pm.test('names the offending field', () => {",
                  "  pm.expect(pm.response.json().error.details[0].path).to.eql('/quantity');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get me (charged exactly once)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "me"
              ]
            },
            "description": "The decisive check: two purchase attempts, one debit."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
