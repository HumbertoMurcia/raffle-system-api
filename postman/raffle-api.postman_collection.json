                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 403', () => pm.response.to.have.status(403));",
                  "pm.test('uses the standard error envelope', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.error.code).to.eql('FORBIDDEN');",
                  "  pm.expect(body.error.message).to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Run the draw for every due raffle",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-admin-key",
                "value": "{{adminKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/draws/run",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "draws",
                "run"
              ]
            },
            "description": "The draw normally runs on a schedule (every 30s). This triggers it on demand. Idempotent: a second run finds nothing left to draw.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 200', () => pm.response.to.have.status(200));",
                  "const { data } = pm.response.json();",
                  "pm.test('every result is a recognised outcome', () => {",
                  "  pm.expect(data).to.be.an('array');",
                  "  data.forEach(r => pm.expect(['drawn', 'closed_no_entries', 'skipped']).to.include(r.outcome));",
                  "});",
                  "pm.test('a drawn raffle names its winning ticket', () => {",
                  "  data.filter(r => r.outcome === 'drawn').forEach(r => {",
                  "    pm.expect(r.winningTicketId).to.be.a('string');",
                  "    pm.expect(r.winnerUserId).to.be.a('string');",
                  "  });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Draw a single raffle",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-admin-key",
                "value": "{{adminKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/raffles/{{pastDrawRaffleId}}/draw",
