# Bun loads .env automatically. Copy this file to .env to override defaults.

PORT=3000

# ":memory:" for an ephemeral database, or a file path.
DATABASE_URL=./data/raffle.sqlite
# Insert demo users and raffles when the database is empty.
DATABASE_SEED=true

# Signing key for the mock bearer tokens. Replace outside development.
AUTH_SECRET=dev-only-insecure-secret
AUTH_TOKEN_TTL_SECONDS=86400

# Background draw job.
DRAW_SCHEDULER_ENABLED=true
DRAW_SCHEDULER_INTERVAL_MS=30000

# Shared secret for the operational /admin endpoints.
ADMIN_API_KEY=dev-admin-key

MAX_TICKETS_PER_PURCHASE=20
LOGGING_ENABLED=true
